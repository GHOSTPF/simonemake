APP_NAME="Simone Gomes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Recife

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Banco de dados — PostgreSQL
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simone
DB_USERNAME=simone
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----------------------------------------------------------------------------
# Fila — os Jobs de WhatsApp e Google Agenda rodam aqui.
# Requer um worker ativo:  php artisan queue:work
# ----------------------------------------------------------------------------
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@simonegomes.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Google Agenda (Service Account)
# ----------------------------------------------------------------------------
# E-mail "client_email" do JSON da conta de serviço (só referência —
# a autenticação usa o arquivo JSON). Compartilhe a agenda da Simone com
# este e-mail com permissão "Fazer alterações nos eventos".
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=

# Caminho ABSOLUTO do arquivo JSON da conta de serviço no servidor
# (mantenha fora do controle de versão).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY_PATH=/caminho/absoluto/service-account.json

# ID da agenda da Simone (Google Calendar -> Configurações da agenda -> ID).
GOOGLE_CALENDAR_ID=

# ----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ----------------------------------------------------------------------------
# Token de acesso do App / System User (de preferência permanente).
WHATSAPP_CLOUD_API_TOKEN=

# ID do número remetente no WhatsApp Business (NÃO é o telefone em si).
WHATSAPP_PHONE_NUMBER_ID=

# Telefone da Simone que recebe o aviso de novo agendamento.
# Só dígitos, com DDI. Ex.: 5583999999999
WHATSAPP_NOTIFY_NUMBER=

VITE_APP_NAME="${APP_NAME}"
